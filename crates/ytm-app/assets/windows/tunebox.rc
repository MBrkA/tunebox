// Windows resources: the file icon (Explorer, taskbar, Alt-Tab) and the version info shown in file properties.
// Compiled by build.rs with rc / llvm-rc / `zig rc`. Keep the version in sync with Cargo.toml.
1 ICON "tunebox.ico"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"
        {
            VALUE "CompanyName", "Tunebox contributors"
            VALUE "FileDescription", "Tunebox - YouTube Music desktop client"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "tunebox"
            VALUE "OriginalFilename", "tunebox.exe"
            VALUE "ProductName", "Tunebox"
            VALUE "ProductVersion", "0.1.0"
            VALUE "LegalCopyright", "MIT License"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
